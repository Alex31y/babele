    <!-- API key (BYOK) -->
    <string name="key_title">Gemini API key</string>
    <string name="key_intro">Babele translates using Google\'s Gemini API. To use the app you need your own API key — it\'s free to start and takes about a minute to create.</string>
    <string name="key_what_is">What\'s an API key? It\'s a personal password that lets this app talk to Google\'s AI on your behalf. Usage is billed to your own Google account, so you stay in control.</string>
    <string name="key_steps_title">How to get one</string>
    <string name="key_step1">1. Tap \"Get a free key\" below — it opens Google AI Studio.</string>
    <string name="key_step2">2. Sign in with your Google account.</string>
    <string name="key_step3">3. Tap \"Create API key\", then copy it.</string>
    <string name="key_step4">4. Come back here, paste it, and tap Save.</string>
    <string name="key_get_button">Get a free key</string>
    <string name="key_field_label">Paste your API key here</string>
    <string name="key_field_placeholder">AIza…</string>
    <string name="key_save">Save key</string>
    <string name="key_clear">Remove key</string>
    <string name="key_privacy">Your key is stored only on this device and is sent solely to Google\'s API. It is never shared with anyone else.</string>
    <string name="key_invalid">That doesn\'t look like a valid key. Gemini keys usually start with \"AIza\".</string>
    <string name="key_settings">API key</string>
